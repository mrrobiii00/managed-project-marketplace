# ── Backend ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# originهای مجاز CORS — با کاما جدا کنید (اختیاری ولی در production توصیه‌شده)
# CORS_ORIGINS=http://localhost:3000

# ── Authentication ───────────────────────────────────────────────
# ⚠️ Secret واقعی اینجا نگذارید — فقط placeholder. تولید Secret قوی:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN=1h

# ── Database ─────────────────────────────────────────────────────
# نمونه‌ی محلی توسعه — مقادیر را با اطلاعات PostgreSQL خودتان جایگزین کنید.
# ⚠️ هرگز رمز واقعی را در این فایل commit نکنید (این فایل در .gitignore است).
# قالب: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/marketplace?schema=public"
