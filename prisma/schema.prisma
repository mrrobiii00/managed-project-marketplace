// =====================================================================
// Managed Software Project Marketplace — MVP Database Schema
// PostgreSQL 14+  ·  Prisma ORM
// Milestone 01: Database Schema only (no API / no UI / no Auth code)
//
// Conventions:
//  - Model/field names are camelCase in Prisma, mapped to snake_case
//    columns/tables via @map / @@map (DB naming per specification).
//  - All primary keys are UUID (generated by Prisma client).
//  - Money  → Decimal(14,2)   Scores → Decimal(5,2)  [0–100]
//  - Relations toward `users` with multiple roles are explicitly named:
//    ClientProjects · SpecialistMatches · AssignedTasks ·
//    RatingGiver · RatingReceiver
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

/// Primary RBAC roles
enum UserRole {
  CLIENT
  SPECIALIST
  ADMIN

  @@map("user_role")
}

/// Specialist availability — input to the matching engine (10% weight)
enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE

  @@map("availability_status")
}

/// Self-declared proficiency per user skill
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("skill_level")
}

/// Project lifecycle:
/// DRAFT → SUBMITTED → MATCHING → REVIEW → TEAM_PROPOSED →
/// IN_PROGRESS → COMPLETED → RATED   (CANCELLED possible from any point)
enum ProjectStatus {
  DRAFT
  SUBMITTED
  MATCHING
  REVIEW
  TEAM_PROPOSED
  IN_PROGRESS
  COMPLETED
  RATED
  CANCELLED

  @@map("project_status")
}

/// Matching triage:
/// total_score >= 85 → RECOMMENDED · 70–84 → NEEDS_REVIEW · < 70 → REJECTED
/// FLAGGED = suspicious / manually flagged by admin
enum MatchStatus {
  RECOMMENDED
  NEEDS_REVIEW
  REJECTED
  FLAGGED

  @@map("match_status")
}

enum TeamStatus {
  PROPOSED
  ACTIVE
  COMPLETED

  @@map("team_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH

  @@map("task_priority")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

// ─────────────────────── Identity & Access ───────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") // Argon2id hash — plain text is never stored
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  profile           Profile?
  userSkills        UserSkill[]
  clientProjects    Project[]    @relation("ClientProjects")
  specialistMatches Match[]      @relation("SpecialistMatches")
  teamMemberships   TeamMember[]
  assignedTasks     Task[]       @relation("AssignedTasks")
  ratingsGiven      Rating[]     @relation("RatingGiver")
  ratingsReceived   Rating[]     @relation("RatingReceiver")

  @@map("users")
}

/// One-to-one extension of User — personal & professional metadata
model Profile {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @map("user_id") @db.Uuid
  fullName          String?             @map("full_name") @db.VarChar(150)
  bio               String?
  jobTitle          String?             @map("job_title") @db.VarChar(150)
  yearsOfExperience Int?                @map("years_of_experience")
  hourlyRate        Decimal?            @map("hourly_rate") @db.Decimal(12, 2) // input to Budget Match (5%)
  availability      AvailabilityStatus?
  avatarUrl         String?             @map("avatar_url")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ───────────────────────────── Skills ────────────────────────────

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  category  String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  userSkills    UserSkill[]
  projectSkills ProjectSkill[]

  @@map("skills")
}

/// Join table: user ↔ skill with proficiency level
model UserSkill {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  skillId           String     @map("skill_id") @db.Uuid
  level             SkillLevel
  yearsOfExperience Int        @default(0) @map("years_of_experience")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId]) // a user cannot list the same skill twice
  @@index([skillId]) // reverse lookup: "which users have skill X?"
  @@map("user_skills")
}

// ───────────────────────────── Projects ──────────────────────────

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @map("client_id") @db.Uuid
  title       String        @db.VarChar(200)
  description String?
  minBudget   Decimal?      @map("min_budget") @db.Decimal(14, 2)
  maxBudget   Decimal?      @map("max_budget") @db.Decimal(14, 2)
  deadline    DateTime?     @db.Date
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  client        User           @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  projectSkills ProjectSkill[]
  roles         ProjectRole[]
  matches       Match[]
  team          Team?
  tasks         Task[]
  ratings       Rating[]

  @@index([clientId])
  @@index([status, createdAt]) // admin queues & public listings
  @@map("projects")
}

/// Join table: project ↔ skill (required vs. optional skills)
model ProjectSkill {
  id         String  @id @default(uuid()) @db.Uuid
  projectId  String  @map("project_id") @db.Uuid
  skillId    String  @map("skill_id") @db.Uuid
  isRequired Boolean @default(true) @map("is_required")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId]) // a project cannot list the same skill twice
  @@index([skillId]) // reverse lookup: "which projects need skill X?"
  @@map("project_skills")
}

/// Requested positions for a project (no separate roles table in MVP)
/// quantity > 0 is enforced at the application layer (CHECK constraint
/// cannot be expressed in Prisma — see docs/milestone-01-database.md)
model ProjectRole {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  roleName  String @map("role_name") @db.VarChar(100)
  quantity  Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_roles")
}

// ───────────────────────── Matching Engine ───────────────────────

/// Snapshot of the matching engine result for one (project, specialist) pair.
/// All scores are 0–100 with 2 decimals.
model Match {
  id                String      @id @default(uuid()) @db.Uuid
  projectId         String      @map("project_id") @db.Uuid
  specialistId      String      @map("specialist_id") @db.Uuid
  skillScore        Decimal     @map("skill_score") @db.Decimal(5, 2) // weight 40%
  experienceScore   Decimal     @map("experience_score") @db.Decimal(5, 2) // weight 20%
  projectScore      Decimal     @map("project_score") @db.Decimal(5, 2) // weight 15%
  ratingScore       Decimal     @map("rating_score") @db.Decimal(5, 2) // weight 10%
  availabilityScore Decimal     @map("availability_score") @db.Decimal(5, 2) // weight 10%
  budgetScore       Decimal     @map("budget_score") @db.Decimal(5, 2) // weight 5%
  totalScore        Decimal     @map("total_score") @db.Decimal(5, 2)
  trustScore        Decimal     @map("trust_score") @db.Decimal(5, 2) // specialist trust snapshot at match time
  status            MatchStatus @default(NEEDS_REVIEW)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specialist User    @relation("SpecialistMatches", fields: [specialistId], references: [id], onDelete: Cascade)

  @@unique([projectId, specialistId]) // no duplicate match per project/specialist
  @@index([specialistId])
  @@index([status]) // triage queues (NEEDS_REVIEW, FLAGGED, ...)
  @@index([projectId, totalScore(sort: Desc)]) // ranked candidate list per project
  @@map("matches")
}

// ───────────────────────────── Teams ─────────────────────────────

/// A project has at most one main team (projectId is @unique)
model Team {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @unique @map("project_id") @db.Uuid
  name      String     @db.VarChar(150)
  teamScore Decimal    @default(0) @map("team_score") @db.Decimal(5, 2)
  status    TeamStatus @default(PROPOSED)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members TeamMember[]
  tasks   Task[]

  @@map("teams")
}

model TeamMember {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String   @db.VarChar(100)
  matchScore Decimal? @map("match_score") @db.Decimal(5, 2) // total_score snapshot at join time
  joinedAt   DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId]) // a user cannot be added to the same team twice
  @@index([userId]) // "which teams does this user belong to?"
  @@map("team_members")
}

// ───────────────────────────── Tasks ─────────────────────────────

/// Kanban board item. assignedTo is nullable: a task can start unassigned
/// and survives specialist removal (onDelete: SetNull).
model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  teamId      String       @map("team_id") @db.Uuid
  assignedTo  String?      @map("assigned_to") @db.Uuid
  title       String       @db.VarChar(200)
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?    @map("due_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // `assignedTo` is the FK column (DB: assigned_to); `assignee` is the relation object
  assignee User?   @relation("AssignedTasks", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([projectId, status]) // project Kanban board columns
  @@index([teamId])
  @@index([assignedTo, status]) // "my tasks" dashboard
  @@map("tasks")
}

// ──────────────────────────── Ratings ────────────────────────────

/// Peer rating after project completion. score ∈ [1, 5] is enforced at the
/// application layer (+ optional CHECK constraint — see docs).
/// Calculated reputation/trust is NOT stored here — it is derived.
model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  score      Int
  review     String?
  createdAt  DateTime @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromUser User    @relation("RatingGiver", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User    @relation("RatingReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromUserId, toUserId]) // one rating per (project, rater, ratee)
  @@index([toUserId]) // reputation aggregation for a user (hot query)
  @@index([fromUserId]) // "ratings I have given"
  @@map("ratings")
}
